{
  "name": "delivery-city",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w packages/server\" \"npm run dev -w packages/client\"",
    "build": "npm run build -w packages/shared && npm run build -w packages/server && npm run build -w packages/client",
    "test": "npm run test -w packages/tests",
    "lint": "eslint .",
    "format:check": "prettier --check \"packages/**/src/**/*.ts\" \"*.md\"",
    "format:write": "prettier --write \"packages/**/src/**/*.ts\" \"*.md\"",
    "build:image": "docker build --platform=linux/amd64 -t nixerr/delivery-city:latest .",
    "push:image": "docker push nixerr/delivery-city:latest",
    "image:build:push": "npm run build:image && npm run push:image"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  }
}
