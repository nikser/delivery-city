{
  "name": "delivery-city",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter @delivery-city/server dev\" \"pnpm --filter @delivery-city/client dev\"",
    "build": "pnpm --filter @delivery-city/shared build && pnpm --filter @delivery-city/server build && pnpm --filter @delivery-city/client build",
    "test": "pnpm --filter @delivery-city/tests test",
    "lint": "oxlint",
    "format:check": "prettier --check \"packages/**/src/**/*.ts\" \"*.md\"",
    "format:write": "prettier --write \"packages/**/src/**/*.ts\" \"*.md\"",
    "build:image": "docker build --platform=linux/amd64 -t nixerr/delivery-city:latest .",
    "push:image": "docker push nixerr/delivery-city:latest",
    "image:build:push": "pnpm build:image && pnpm push:image"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1"
  },
  "packageManager": "pnpm@12.21.0"
}
